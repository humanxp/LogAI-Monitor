# ============ LogAI Monitor / LogRadarAI - deployment template ============
# Copy to .env and fill in real values:  cp .env.example .env

# --- Security ---
# Generate one: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=false

# --- AI provider ---
# AI_PROVIDER: "openai" (any OpenAI-compatible server: vLLM/SGLang/omlx/...) or "ollama" (native)
AI_PROVIDER=openai
# OpenAI-compatible endpoint (include /v1)
AI_BASE_URL=http://YOUR-AI-SERVER:8000/v1
AI_API_KEY=sk-your-key
# Model served by the AI endpoint
OLLAMA_MODEL=Llama-3.2-3B-Instruct-4bit

# --- Optional: native Ollama (used only when AI_PROVIDER=ollama) ---
# OLLAMA_HOST=http://host.docker.internal:11434

# --- Syslog receiver ports (UDP=SYSLOG_PORT, TCP=SYSLOG_PORT+1) ---
SYSLOG_PORT=514

# --- Logs / analysis ---
# Retention (hours) applied as Redis TTL to each stored log
LOG_RETENTION_HOURS=12
# Auto-analysis cadence in minutes (scheduler reads this at startup)
ANALYSIS_INTERVAL_MINUTES=2
# Logs fetched per analysis run (also the "500 pending logs" immediate trigger threshold)
MAX_LOGS_PER_ANALYSIS=500
# Lines of logs actually sent to the AI per batch (severity-priority sampling cap)
BATCH_SAMPLE_LIMIT=100
# Minimum seconds between batch-threshold triggered analysis attempts
BATCH_TRIGGER_MIN_INTERVAL=30

# --- Optional: Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: base image for a FRESH machine (see DEPLOY.md) ---
# Leave empty on this machine (uses local image logradarai:local).
# On a new machine with internet but no exported image, use the public base:
# BASE_IMAGE=ftsiadimos/logradaraiq:latest
