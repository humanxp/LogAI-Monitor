# 复制为 .env 后按需修改：  cp .env.example .env
# 生成密钥：  openssl rand -hex 32

# 必填：会话签名密钥（固定不变，否则每次重启所有人掉线）
SECRET_KEY=change-me-openssl-rand-hex-32

# 对外端口（左边可改，右边是容器内固定端口）
WEB_PORT=5059
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=515

# 容器与网络名（同机并行跑多套实例时才需要改）
APP_CONTAINER=logaimonitor
REDIS_CONTAINER=logaimonitor-redis
NETWORK_NAME=logai-net

# Redis 上限：按主机内存给，预留系统与其它服务
REDIS_MAXMEMORY=9216mb

# AI 后端（可在设置页里改，这里是初始值）
OLLAMA_MODEL=Llama-3.2-3B-Instruct-4bit
AI_API_KEY=

# 采集容器日志：on / off
DOCKER_COLLECTION=on

TZ=Asia/Shanghai
