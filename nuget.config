<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 构建主机所在网络的网关会把 api.nuget.org 解析成 198.18.x.x 假地址（DNS 投毒），
       导致 docker build 里 dotnet publish 还原包失败。这里改用国内可达的华为云镜像，
       并把官方源放在后面作兜底。 -->
  <packageSources>
    <clear />
    <add key="huawei" value="https://repo.huaweicloud.com/repository/nuget/v3/index.json" />
  </packageSources>
</configuration>
